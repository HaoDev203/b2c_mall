<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zh.b2cmall</groupId>
        <artifactId>b2c_mall</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.zh.b2cmall.malltdd</groupId>
    <artifactId>mall-tdd</artifactId>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.11</jacoco.version>
    </properties>

    <dependencies>
        <!-- ★ 刻意不加 nacos：88 条全部是纯 Mockito 单元测试，不启动 Spring 容器，
             引入注册中心只会拖慢构建，并在无网络时制造假失败。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- ★ 版本由根 pom 的 dependencyManagement 统一管理，这里写 version 会与之冲突 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>

            <!-- ★★ 必须重写 surefire 的 argLine。
                 根 pom 里写的是 <argLine>-Dfile.encoding=UTF-8</argLine>，
                 这会**整体覆盖** jacoco prepare-agent 注入的 -javaagent，
                 结果是测试照跑、覆盖率永远 0、日志里只有一句静默的
                 "Skipping JaCoCo execution due to missing execution data file"。
                 @{argLine} 是「延迟求值」：先拼上 jacoco 的 agent，再追加编码参数。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <!-- ★ B0 的验收物之一：从第一条测试起就有覆盖率曲线 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- 启动类不含业务逻辑，纳入覆盖率只会永久拉低数字 -->
                    <excludes>
                        <exclude>com/mall/tdd/MallTddApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 绑到 test 阶段：mvn test 就直接产出报告，不用额外记一个 goal -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
